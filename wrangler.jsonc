// Cấu hình deploy lên Cloudflare Workers
// - public/: trang tĩnh (ảnh, CSS, JS) do Cloudflare trả thẳng
// - src/index.js: chỉ chạy cho trang chủ "/", chèn tên khách từ ?to=Tên vào HTML
{
  "name": "congtuan-totnghiep",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/"]
  }
}
